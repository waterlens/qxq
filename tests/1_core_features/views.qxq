(* RUN: {qxq|cargo run --} --inspect %s *)
type ABC = struct {a, b, c} end;
type BC = struct {b, c}
  with fn sum(self) self.b + self.c end
  with fn set(self, v) self.b <- v end
end;
let o = ABC{1, 2, 3};
(o : BC).c <- 4;
(o : BC).sum() + (o : BC).2 + o.b
(* EXPECT:
   --- Syntax Tree ---
   (block (type ABC (struct (fields a b c))) (type BC (struct (fields b c) (method sum (self) (+ (member self b) (member self c))) (method set (self v) (<- (member self b) v)))) (let o (construct ABC (init _ 1) (init _ 2) (init _ 3))) (<- (member (view o BC) c) 4) (+ (+ (member-apply (view o BC) sum) (index (view o BC) 2)) (member o b)))
   --- Thunk ---
   thunk::fn params::1 regs::3 captured::[]
   loadslot     r1, r0, #0
   exta         #1
   loadslot     r2, r0, #1
   exta         #1
   add.dd       r1, r1, r2
   ret          r1

   --- Thunk ---
   thunk::fn params::2 regs::3 captured::[]
   setslot      r1, r0, #0
   exta         #1
   loadr        r2, unit
   ret          r2

   --- Thunk ---
   thunk::__top_thunk__ params::0 regs::5 captured::[]
   constants::[
     @0: "sum"
     @1: "b"
   ]
   loadty       r0, @0
   loadi        r1, #1
   loadi        r2, #2
   loadi        r3, #3
   wrap         r0, tag::struct, #4
   loadty       r1, @1
   view         r1, r0, r1
   loadi        r2, #4
   setind       r2, r1, #1
   exta         #1
   loadty       r4, @1
   view         r3, r0, r4
   invoke       r1, r3, @0
   loadty       r2, @1
   view         r2, r0, r2
   loadind      r2, r2, #1
   exta         #1
   add.dd       r1, r1, r2
   loadfld      r2, r0, @1
   add.dd       r1, r1, r2
   ret          r1
*)
