(* RUN: {qxq|cargo run -- --inspect} %s *)
1 < 2;
1 > 2;
1 <= 2;
1 >= 2;
1 == 2;
1 != 2;

let eq0 = fn (n) n == 0 end;
let choose = fn (b, x)
  if b then
    x == 0
  else
    x != 0
  end
end;

eq0(1) == false;
if choose(false, 0) then 30 else 40 end

