(* RUN: {qxq|cargo run -- --inspect} %s *)
let greeting = "hello";
let name = "world";

let greet = fn (n) greeting + ", " + n + "!" end;

greet(name);

let repeat = fn (s, n)
  let rec iter = fn (i, acc)
    if i >= n then
      acc
    else
      iter(i + 1, acc + s)
    end
  end;
  iter(0, "")
end;

repeat("ha", 3)

(* EXPECT:
   --- Syntax Tree ---
   (block (let greeting "hello") (let name "world") (let greet (fn (n) (+ (+ (+ greeting ", ") n) "!"))) (greet name) (let repeat (fn (s n) (block (let-rec iter (fn iter (i acc) (if (>= i n) acc (iter (+ i 1) (+ acc s))))) (iter 0 "")))) (repeat "ha" 3))
   --- Thunk ---
   thunk::fn params::1 regs::3 captured::[r0 as ^1]
   constants::[
     @0: ", "
     @1: "!"
   ]
   loadf        r1, ^1
   loadc        r2, @0
   add.dd       r1, r1, r2
   add.dd       r1, r1, r0
   loadc        r2, @1
   add.dd       r1, r1, r2
   ret          r1
   
   --- Thunk ---
   thunk::fn params::2 regs::7 captured::[r1 as ^1, r0 as ^2]
   loadf        r2, ^1
   cmp.ge.dd    r0, r2
   jmp          #1
   ret          r1
   loadf        r2, ^0
   loadi        r3, #0
   loadi        r6, #1
   add.dd       r4, r0, r6
   loadf        r6, ^2
   add.dd       r5, r1, r6
   apply        r2, #2
   ret          r2
   
   --- Thunk ---
   thunk::fn params::2 regs::7 captured::[]
   constants::[
     @0: ""
   ]
   clos         r2, fn1
   move         r3, r2
   loadi        r4, #0
   loadi        r5, #0
   loadc        r6, @0
   apply        r3, #2
   ret          r3
   
   --- Thunk ---
   thunk::__top_thunk__ params::0 regs::8 captured::[]
   constants::[
     @0: "hello"
     @1: "world"
     @2: "ha"
   ]
   loadc        r0, @0
   loadc        r1, @1
   clos         r2, fn0
   move         r3, r2
   loadi        r4, #0
   move         r5, r1
   apply        r3, #1
   clos         r3, fn2
   move         r4, r3
   loadi        r5, #0
   loadc        r6, @2
   loadi        r7, #3
   apply        r4, #2
   ret          r4
*)
