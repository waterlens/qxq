(* RUN: {qxq|cargo run --} --inspect %s *)
let x = 1;
let y = 2;
x + y;

let rec factorial = fn (n)
  if n < 2 then
    1
  else
    n * factorial(n - 1)
  end
end;

factorial(5)

(* EXPECT:
   --- Syntax Tree ---
   (block (let x 1) (let y 2) (+ x y) (let-rec factorial (fn factorial (n) (if (< n 2) 1 (* n (factorial (- n 1)))))) (factorial 5))
   --- Thunk ---
   thunk::fn params::1 regs::4 captured::[]
   constants::[
     @0: 2
     @1: 1
   ]
   cmp.lt.dc    r0, @0
   jmp          #2
   loadi        r1, #1
   ret          r1
   loadfree     r1, ^0
   sub.dc       r3, r0, @1
   apply        r1, #1
   mul.dd       r1, r0, r1
   ret          r1

   --- Thunk ---
   thunk::__top_thunk__ params::0 regs::6 captured::[]
   loadi        r0, #1
   loadi        r1, #2
   add.dd       r2, r0, r1
   clos         r2, fn0
   move         r3, r2
   loadi        r5, #5
   apply        r3, #1
