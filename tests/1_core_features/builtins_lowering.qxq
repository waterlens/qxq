(* RUN: {qxq|cargo run --} --inspect --no-tree %s *)

let v = 42;
Builtin.print_raw(v);
Builtin.print_raw_hex(v);
Builtin.assert_eq(v, 42);
Builtin.print_object("hi");
Builtin.heap_stat()

