(* RUN: {qxq|cargo run --} --inspect %s *)
fn () 1 end;

fn (x) x end;

fn (x, y) x + y end;

let add = fn (a, b) a + b end;
add(1, 2)

(* EXPECT:
   --- Syntax Tree ---
   (block (fn () 1) (fn (x) x) (fn (x y) (+ x y)) (let add (fn (a b) (+ a b))) (add 1 2))
   --- Thunk ---
   thunk::fn params::0 regs::1 captured::[]
   loadi        r0, #1
   ret          r0

   --- Thunk ---
   thunk::fn params::1 regs::1 captured::[]
   ret          r0

   --- Thunk ---
   thunk::fn params::2 regs::3 captured::[]
   add.dd       r2, r0, r1
   ret          r2

   --- Thunk ---
   thunk::fn params::2 regs::3 captured::[]
   add.dd       r2, r0, r1
   ret          r2

   --- Thunk ---
   thunk::__top_thunk__ params::0 regs::5 captured::[]
   clos         r0, fn0
   clos         r0, fn1
   clos         r0, fn2
   clos         r0, fn3
   move         r1, r0
   loadi        r3, #1
   loadi        r4, #2
   apply        r1, #2
   ret          r1
*)
