(* RUN: {qxq|cargo run -- --inspect} %s *)
let compose = fn (f, g) fn (x) f(g(x)) end end;
let inc = fn(x) x + 1 end;
let inc2 = compose(inc, inc);
inc2(5)

(* EXPECT:
   --- Syntax Tree ---
   (block (let compose (fn (f g) (fn (x) (f (g x))))) (let inc (fn (x) (+ x 1))) (let inc2 (compose inc inc)) (inc2 5))
   --- Thunk ---
   thunk::fn params::1 regs::9 captured::[r0 as ^0, r1 as ^1]
   loadf        r1, ^0
   loadi        r2, #0
   loadi        r3, #0
   loadf        r5, ^1
   loadi        r6, #0
   loadi        r7, #0
   move         r8, r0
   apply        r5, #1
   move         r4, r5
   apply        r1, #1
   ret          r1
   
   --- Thunk ---
   thunk::fn params::2 regs::3 captured::[]
   clos         r2, fn0
   ret          r2
   
   --- Thunk ---
   thunk::fn params::1 regs::2 captured::[]
   constants::[
     @0: 1
   ]
   loadc        r1, @0
   add.dd       r1, r0, r1
   ret          r1
   
   --- Thunk ---
   thunk::__top_thunk__ params::0 regs::8 captured::[]
   constants::[
     @0: 5
   ]
   clos         r0, fn1
   clos         r1, fn2
   move         r3, r0
   loadi        r4, #0
   loadi        r5, #0
   move         r6, r1
   move         r7, r1
   apply        r3, #2
   move         r2, r3
   move         r3, r2
   loadi        r4, #0
   loadi        r5, #0
   loadc        r6, @0
   apply        r3, #1
   ret          r3
*)
