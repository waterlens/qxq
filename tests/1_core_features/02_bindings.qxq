(* RUN: {qxq|cargo run --} %s *)
let x = 1;
let y = 2;
x + y;

let rec factorial = fn (n)
  if n < 2 then
    1
  else
    n * factorial(n - 1)
  end
end;

factorial(5)

(* EXPECT:
   --- Syntax Tree ---
   (block (let x 1) (let y 2) (+ x y) (let-rec factorial (fn (n) (if (< n 2) 1 (* n (factorial (- n 1)))))) (factorial 5))
   --- Constant Pool ---
   --- Integer Constants ---
   @0: 1
   @1: 2
   @2: 5
   --- String Constants ---
   
   --- Thunk ---
   thunk::fn captured::[r3 as ^0]
   loadc        r1, @1
   cmp.lt.dd    r0, r1
   jmp          #2
   loadc        r1, @0
   retn         r1, #0
   loadf        r1, ^0
   loadc        r3, @0
   sub.dd       r2, r0, r3
   apply        r1, #1
   mul.dd       r1, r0, r1
   retn         r1, #0
   
   --- Thunk ---
   thunk::__top_thunk__ captured::[]
   loadc        r0, @0
   loadc        r1, @1
   add.dd       r2, r0, r1
   clos         r3, fn0
   move         r4, r3
   loadc        r5, @2
   apply        r4, #1
   retn         r4, #0
*)
