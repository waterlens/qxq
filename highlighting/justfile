# Justfile for qxq tree-sitter highlighting

default:
    @just --list

# Generate the parser from grammar.js
generate:
    tree-sitter generate

# Compile the parser to a shared object
build: generate
    tree-sitter build

# Run tree-sitter tests (requires grammar generation first)
test: generate
    tree-sitter test

# Install to Neovim (binary + queries + config)
install: build
    uv run manage_nvim.py install

# Uninstall from Neovim
uninstall:
    uv run manage_nvim.py uninstall

# Remove compiled binaries
clean:
    rm -f parser.dylib parser.so qxq.so
    rm -rf build/

# Remove all generated files (including src/)
dist-clean: clean
    rm -rf src/
    rm -f binding.gyp

