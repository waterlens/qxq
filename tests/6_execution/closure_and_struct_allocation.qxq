(* SKIP: segfaults once enough closures and structs have been allocated *)
(* RUN: {qxq|cargo run --} %s *)

type P = struct {x} with fn get(self) self.x end end;
let rec f = fn (n)
  let make = fn (v) P{v} end;
  if n < 2 then make(n).get() - n + 1 else f(n - 1) + f(n - 2) end
end;
f(18)

(* EXPECT:
   4181
*)
