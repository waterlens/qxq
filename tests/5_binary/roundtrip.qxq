(* RUN: bash -c "diff <({qxq|cargo run -- --inspect} %s --no-tree) <({qxq|cargo run -- --inspect} %s --dump - | {qxq|cargo run -- --inspect --load} -) || true" *)
let s = "qx";
let i = 100;
let f = fn (x)
  let g = fn (y)
    let res = x + y + i;
    res
  end;
  g(x)
end;
let result = f(1);
(s, result)
(* EXPECT:
   2c2
   < thunk::fn params::1 regs::4 captured::[^1 as ^1, r0 as ^2]
   ---
   > thunk:: params::1 regs::4 captured::[^1 as ^1, r0 as ^2]
   10c10
   < thunk::fn params::1 regs::5 captured::[r1 as ^1]
   ---
   > thunk:: params::1 regs::5 captured::[r1 as ^1]
   19c19
   < thunk::__top_thunk__ params::0 regs::7 captured::[]
   ---
   > thunk:: params::0 regs::7 captured::[]
*)
