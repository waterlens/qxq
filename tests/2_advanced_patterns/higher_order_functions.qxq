(* RUN: {qxq|cargo run -- --inspect} %s *)
let compose = fn (f, g) fn (x) f(g(x)) end end;
let inc = fn(x) x + 1 end;
let inc2 = compose(inc, inc);
inc2(5)

(* EXPECT:
   --- Syntax Tree ---
   (block (let compose (fn (f g) (fn (x) (f (g x))))) (let inc (fn (x) (+ x 1))) (let inc2 (compose inc inc)) (inc2 5))
   --- Thunk ---
   thunk::fn params::1 regs::7 captured::[r0 as ^1, r1 as ^2]
   loadf        r1, ^1
   loadf        r4, ^2
   move         r6, r0
   apply        r4, #1
   move         r3, r4
   apply        r1, #1
   ret          r1
   
   --- Thunk ---
   thunk::fn params::2 regs::3 captured::[]
   clos         r2, fn0
   ret          r2
   
   --- Thunk ---
   thunk::fn params::1 regs::2 captured::[]
   constants::[
     @0: 1
   ]
   add.dc       r1, r0, @0
   ret          r1
   
   --- Thunk ---
   thunk::__top_thunk__ params::0 regs::7 captured::[]
   clos         r0, fn1
   clos         r1, fn2
   move         r3, r0
   move         r5, r1
   move         r6, r1
   apply        r3, #2
   move         r2, r3
   move         r3, r2
   loadi        r5, #5
   apply        r3, #1
   ret          r3
*)
