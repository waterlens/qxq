   thunk::__top_thunk__ params::0 regs::2 captured::[]
   constants::[
     @0: 0
     @1: "not"
     @2: " greater"
   ]
   loadi        r0, #1
   cmp.gt.dc    r0, @0
   jmp          #1
   jmp          #3
   loadc        r0, @1
   loadc        r1, @2
   add.dd       r0, r0, r1
   loadr        r0, #0x7
   cmp.not.f    r0, #0
   jmp          #2
   loadi        r0, #1
   ret          r0
   loadi        r0, #0
   ret          r0
*)
