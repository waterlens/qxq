   @0: 1
   @1: 2
   --- String Constants ---
   
   --- Thunk ---
   thunk::fn captured::[]
   loadc        r0, @0
   retn         r0, #0
   
   --- Thunk ---
   thunk::fn captured::[]
   retn         r0, #0
   
   --- Thunk ---
   thunk::fn captured::[]
   add.dd       r2, r0, r1
   retn         r2, #0
   
   --- Thunk ---
   thunk::fn captured::[]
   add.dd       r2, r0, r1
   retn         r2, #0
   
   --- Thunk ---
   thunk::__top_thunk__ captured::[]
   clos         r0, fn0
   clos         r0, fn1
   clos         r0, fn2
   clos         r0, fn3
   move         r1, r0
   loadc        r2, @0
   loadc        r3, @1
   apply        r1, #2
   retn         r1, #0
