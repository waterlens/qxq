type AC = struct {a, c} end;
type XABC = struct {x, a, b, c} end;
let v = XABC{0, 1, 2, 3} : AC;
let rec run = fn (n)
  let s = v.a + v.c + v.a + v.c + v.a + v.c + v.a + v.c;
  let s = s + v.a + v.c + v.a + v.c + v.a + v.c + v.a + v.c;
  if n > 0 then run(n - 1) + run(n - 1) else s end
end;
run(20)
