   ]
   loadc        r1, @0
   cmp.lt.dd    r0, r1
   jmp          #2
   loadc        r1, @1
   ret          r1
   loadf        r1, ^0
   loadi        r2, #0
   loadc        r4, @1
   sub.dd       r3, r0, r4
