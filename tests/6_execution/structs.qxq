(* RUN: {qxq|cargo run --} %s *)

let r = 0;

(* explicit arguments follow self *)
type Acc = struct {base}
  with fn add(self, x, y) self.base + x * 10 + y end
end;
let acc = Acc{100};
let r = r + if acc.add(2, 3) == 123 then 0 else 1 end;

(* labeled, positional and reordered initializers *)
type P = struct {x, y, z}
  with fn sum(self) self.x * 100 + self.y * 10 + self.z end
end;
let r = r + if P{1, 2, 3}.sum() == 123 then 0 else 2 end;
let r = r + if P{z = 3, 1, y = 2}.sum() == 123 then 0 else 4 end;
let r = r + if P{y = 2, z = 3, x = 1}.x == 1 then 0 else 8 end;

(* mutual recursion between siblings, also from a nested closure *)
type Parity = struct {}
  with fn even(self, n) if n == 0 then true else odd(n - 1) end end
  with fn odd(self, n) if n == 0 then false else even(n - 1) end end
  with fn nested(self, n) let f = fn (k) even(k) end; f(n) end
end;
let p = Parity{};
let r = r + if p.even(10) then 0 else 16 end;
let r = r + if p.odd(7) then 0 else 32 end;
let r = r + if p.nested(4) then 0 else 64 end;

(* a nested call restores the caller's constant table *)
type Pair = struct {left, right}
  with fn both(self) self.left + self.helper() + self.right end
  with fn helper(self) self.right * 1000 end
end;
let r = r + if Pair{1, 2}.both() == 2003 then 0 else 128 end;

type Two = struct {p, q} end;
let make = fn (k)
  type T = struct {v, k} with fn get(self) self.v + self.k end end;
  Two{T{1, k}, T{2, k}}
end;
let r = r + if make(10).p.get() + make(20).q.get() == 11 + 22 then 0 else 256 end;
Builtin.assert_eq(make(1).p.get, make(2).q.get);

let build = fn (n) P{n, n, n} end;
let r = r + if build(4).sum() == 444 then 0 else 512 end;

type Node = struct {v} with fn dup(self) Node{self.v} end end;
let r = r + if Node{7}.dup().v == 7 then 0 else 1024 end;

type Point = struct {x, y}
  with fn origin() Point{0, 0} end
  with fn of(v) build(v, v) end
  with fn build(x, y) Point{x, y} end
  with fn norm(self) self.x * self.x + self.y * self.y end
  with fn twice(self) build(self.x * 2, self.y * 2) end
end;
let r = r + if Point.origin().norm() == 0 then 0 else 2048 end;
let r = r + if Point.of(3).twice().norm() == 72 then 0 else 4096 end;
let r = r + if Point.norm(Point.of(1)) == 2 then 0 else 8192 end;
let of = Point.of;
let r = r + if of(2).x == 2 then 0 else 16384 end;

r

(* EXPECT:
   0
*)
