(* RUN: {qxq|cargo run --} %s *)
let compose = fn (f, g) fn (x) f(g(x)) end end;
let inc = fn(x) x + 1 end;
let inc2 = compose(inc, inc);
inc2(5)

(* EXPECT:
   --- Syntax Tree ---
   (block (let compose (fn (f g) (fn (x) (f (g x))))) (let inc (fn (x) (+ x 1))) (let inc2 (compose inc inc)) (inc2 5))
   --- Constant Pool ---
   --- Integer Constants ---
   @0: 1
   @1: 5
   --- String Constants ---
   
   --- Thunk ---
   thunk::fn captured::[r0 as ^0 ,r1 as ^1]
   loadf        r1, ^0
   loadf        r3, ^1
   move         r4, r0
   apply        r3, #1
   move         r2, r3
   apply        r1, #1
   retn         r1, #0
   
   --- Thunk ---
   thunk::fn captured::[]
   clos         r2, fn0
   retn         r2, #0
   
   --- Thunk ---
   thunk::fn captured::[]
   loadc        r1, @0
   add.dd       r1, r0, r1
   retn         r1, #0
   
   --- Thunk ---
   thunk::__top_thunk__ captured::[]
   clos         r0, fn1
   clos         r1, fn2
   move         r3, r0
   move         r4, r1
   move         r5, r1
   apply        r3, #2
   move         r2, r3
   move         r3, r2
   loadc        r4, @1
   apply        r3, #1
   retn         r3, #0
*)
