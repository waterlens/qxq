     @0: "x"
     @1: 0
   ]
   loadty       r0, ty0
   loadi        r1, #1
   wrap         r0, tag::struct, #2
   loadi        r1, #2
   setmem       r1, r0, @0
   loadi        r1, #3
   setmem       r1, r0, @1
   loadr        r1, unit
   ret          r1
*)
