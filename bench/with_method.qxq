type AC = struct {a, c}
  with fn sum(self) self.a + self.c end
end;
type XABC = struct {x, a, b, c} end;
let o = XABC{0, 1, 2, 3};
with o : AC in
  let rec run = fn (n)
    let s = o.sum() + o.sum() + o.sum() + o.sum();
    let s = s + o.sum() + o.sum() + o.sum() + o.sum();
    if n > 0 then run(n - 1) + run(n - 1) else s end
  end;
  run(20)
end
