(* RUN: rm -f /tmp/qxq_file_edit_missing.bin && {qxq|cargo run --} %s && xxd -p /tmp/qxq_file_edit_missing.bin && rm -f /tmp/qxq_file_edit_missing.bin *)

let f = File.open("/tmp/qxq_file_edit_missing.bin");
let status = if f.size() == 0 then 0 else 1 end;
