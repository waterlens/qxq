(* RUN: {qxq|cargo run --} --inspect %s *)
type Counter = struct {n}
  with fn add(self, k) self.n + k end
  with fn twice(self, k) add(k) + self.add(k) end
  with fn later(self) fn (k) add(k) end end
end;
let c = Counter{n = 1};
c.twice(2) + c.later()(3)
