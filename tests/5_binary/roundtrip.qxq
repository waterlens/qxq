(* RUN: {qxq|cargo run --} %s --dump - | {qxq|cargo run --} --load - *)
let s = "qx";
let i = 100;
let f = fn (x)
  let g = fn (y)
    let res = x + y + i;
    res
  end;
  g(x)
end;
let result = f(1);
(s, result)
(* EXPECT:
   --- Thunk ---
   thunk:: params::1 regs::4 captured::[^0 as ^0, r0 as ^1]
