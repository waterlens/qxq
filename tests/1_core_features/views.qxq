(* RUN: {qxq|cargo run --} --inspect %s *)
type ABC = struct {a, b, c} end;
type BC = struct {b, c}
  with fn sum(self) self.b + self.c end
  with fn set(self, v) self.b <- v end
end;
let o = ABC{1, 2, 3};
let s = with o : BC in
  o.c <- 4;
  o.sum() + o.2 + o.b
end;
(o : BC).b + s
(* EXPECT:
   --- Syntax Tree ---
   (block (type ABC (struct (fields a b c))) (type BC (struct (fields b c) (method sum (self) (+ (member self b) (member self c))) (method set (self v) (<- (member self b) v)))) (let o (construct ABC (init _ 1) (init _ 2) (init _ 3))) (let s (with o (view o BC) (block (<- (member o c) 4) (+ (+ (member-apply o sum) (index o 2)) (member o b))))) (+ (member (view o BC) b) s))
   --- Type ---
   type::ABC fields::[a, b, c] methods::[] functions::[]
   type::BC fields::[b, c] methods::[sum as fn0, set as fn1] functions::[]

   --- Thunk ---
   thunk::fn params::1 regs::3 captured::[]
   loadslot     r1, r0, #0
   exta         #1
   loadslot     r2, r0, #1
   exta         #1
   add.dd       r1, r1, r2
   ret          r1

   --- Thunk ---
   thunk::fn params::2 regs::3 captured::[]
   setslot      r1, r0, #0
   exta         #1
   loadr        r2, unit
   ret          r2

   --- Thunk ---
   thunk::__top_thunk__ params::0 regs::6 captured::[]
   constants::[
     @0: "b"
   ]
   loadty       r0, ty0
   loadi        r1, #1
   loadi        r2, #2
   loadi        r3, #3
   wrap         r0, tag::struct, #4
   loadty       r3, ty1
   view         r2, r0, r3
   loadi        r3, #4
   setind       r3, r2, #1
   exta         #1
   move         r5, r2
   invokeind    r3, r5, #0
   exta         #1
   apply        r3, #0
   loadind      r4, r2, #1
   exta         #1
   add.dd       r3, r3, r4
   loadind      r4, r2, #0
   exta         #1
   add.dd       r1, r3, r4
   loadty       r2, ty1
   view         r2, r0, r2
   loadmem      r2, r2, @0
   add.dd       r2, r2, r1
   ret          r2
*)
