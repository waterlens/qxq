   constants::[
     @0: 1
   ]
   loadc        r0, @0
   retn         r0, #0
   
   --- Thunk ---
   thunk::fn params::1 regs::1 captured::[]
   retn         r0, #0
   
   --- Thunk ---
   thunk::fn params::2 regs::3 captured::[]
   add.dd       r2, r0, r1
   retn         r2, #0
   
   --- Thunk ---
   thunk::fn params::2 regs::3 captured::[]
   add.dd       r2, r0, r1
   retn         r2, #0
   
   --- Thunk ---
   thunk::__top_thunk__ params::0 regs::4 captured::[]
   constants::[
     @0: 1
     @1: 2
   ]
   clos         r0, fn0
   clos         r0, fn1
   clos         r0, fn2
   clos         r0, fn3
   move         r1, r0
   loadc        r2, @0
   loadc        r3, @1
