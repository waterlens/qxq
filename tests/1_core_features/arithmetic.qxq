   wrap         r0, k1, #3
   loadi        r0, #1
   setc         r0, #0
   cmp.lt.dc    r0, @3
   loadi        r0, #1
   setc         r0, #0
   cmp.gt.dc    r0, @3
   loadi        r0, #1
   setc         r0, #0
   cmp.le.dc    r0, @3
