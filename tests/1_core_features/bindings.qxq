(* RUN: {qxq|cargo run -- --inspect} %s *)
let x = 1;
let y = 2;
x + y;

let rec factorial = fn (n)
  if n < 2 then
    1
  else
    n * factorial(n - 1)
  end
end;

factorial(5)

(* EXPECT:
   --- Syntax Tree ---
   (block (let x 1) (let y 2) (+ x y) (let-rec factorial (fn factorial (n) (if (< n 2) 1 (* n (factorial (- n 1)))))) (factorial 5))
