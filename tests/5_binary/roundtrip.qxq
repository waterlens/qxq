   add.dd       r1, r2, r3
   retn         r1, #0
   
   --- Thunk ---
   thunk:: params::1 regs::4 captured::[r1 as ^0]
   clos         r1, fn0
   move         r2, r1
   move         r3, r0
   apply        r2, #1
   retn         r2, #0
   
   --- Thunk ---
