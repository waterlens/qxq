(* RUN: {qxq|cargo run --} --inspect %s *)
type Counter = struct {n}
  with fn zero() Counter{0} end
  with fn add(self, k) Counter{self.n + k} end
  with fn twice(k) Counter.add(zero(), k).add(k) end
end;
Counter.twice(2).n + Counter.zero().add(1).n
